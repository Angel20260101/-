# Copy to .env and fill in. Never commit .env.
# Run locally with:  node --env-file=.env src/index.js
# Preview without sending mail:  DRY_RUN=1 node --env-file=.env src/index.js

# ---- LLM (one key; which provider it belongs to is set by LLM_PROVIDER) ----
LLM_PROVIDER=openai          # openai | gemini | groq
LLM_API_KEY=
# LLM_MODEL=                 # blank uses the provider default
                             #   openai -> gpt-4o-mini
                             #   gemini -> gemini-3.8-flash
                             #   groq   -> llama-3.3-70b-versatile
                             # A rejected model is replaced automatically with
                             # one the key can actually use.

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # "Rachel"
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_ENABLED=true
# TTS_MAX_CHARS=2500         # quota guard; longer scripts are trimmed

# ---- Gmail (an App Password, NOT your Google login password) ----
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
MAIL_TO=you@gmail.com
# MAIL_FROM_NAME=English Lesson Bot
# MAIL_SUBJECT_PREFIX=🎧 本週英語課

# ---- Podcast and lesson shape ----
# PODCAST_RSS_URL=https://podcasts.files.bbci.co.uk/p02pc9zn.rss   # BBC 6 Minute English
# LESSON_LEVEL=B1-B2
# NATIVE_LANGUAGE=繁體中文
# VOCAB_COUNT=8
# PHRASE_COUNT=5
# QUESTION_COUNT=3
# MAX_EPISODE_AGE_DAYS=14
# IGNORE_STATE=false         # true resends the newest episode
