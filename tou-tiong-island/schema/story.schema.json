{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tou-tiong-island.app/schema/story.schema.json",
  "title": "Tou-Tiong Island Story Document",
  "description": "資料驅動劇情引擎的單篇故事定義。新增故事只需新增一份符合此 schema 的 JSON，不需要修改引擎程式碼。",
  "type": "object",
  "required": [
    "story_id", "version", "schema_version", "title", "island_id", "theme",
    "characters", "state_vars", "start_node_id", "nodes", "endings", "routes"
  ],
  "additionalProperties": false,
  "properties": {
    "story_id":       { "type": "string", "pattern": "^story_[0-9]{2}_[a-z0-9_]+$" },
    "version":        { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "title":          { "type": "string", "minLength": 1 },
    "subtitle":       { "type": "string" },
    "island_id":      { "type": "string", "pattern": "^island_[a-z_]+$" },
    "order":          { "type": "integer", "minimum": 1 },
    "theme":          { "type": "string", "minLength": 1 },
    "logline":        { "type": "string" },
    "estimated_minutes": { "type": "number", "minimum": 0.5, "maximum": 15 },
    "content_notes":  { "type": "array", "items": { "type": "string" } },
    "setting":        {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string" },
        "time":     { "type": "string" },
        "conflict": { "type": "string" }
      }
    },
    "characters": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["character_id", "name", "role"],
        "additionalProperties": false,
        "properties": {
          "character_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name":    { "type": "string" },
          "role":    { "type": "string" },
          "profile": { "type": "string" },
          "voice":   { "type": "string", "description": "說話方式與語氣，供編劇與配音參考" }
        }
      }
    },
    "state_vars": {
      "type": "array", "minItems": 1,
      "description": "本篇故事使用的狀態變數。航線判定只能讀這些變數與 tags。",
      "items": {
        "type": "object",
        "required": ["key", "label", "init"],
        "additionalProperties": false,
        "properties": {
          "key":   { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "label": { "type": "string" },
          "init":  { "type": "integer" },
          "description": { "type": "string" }
        }
      }
    },
    "start_node_id": { "type": "string" },
    "nodes": {
      "type": "array", "minItems": 2,
      "items": { "$ref": "#/definitions/node" }
    },
    "endings": {
      "type": "array", "minItems": 2,
      "items": { "$ref": "#/definitions/ending" }
    },
    "routes": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "description": "三條主要航線，依 priority 由小到大評估，第一個命中的航線即為結果；最後一條必須是 {\"always\": true} 保底，確保任何遊玩組合都落在恰好一條航線上。",
      "items": { "$ref": "#/definitions/route" }
    },
    "replay_hints": {
      "type": "array",
      "description": "重新遊玩時可探索的不同內容（給玩家看的提示文案）。",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "dialogue_line": {
      "type": "object",
      "required": ["speaker", "text"],
      "additionalProperties": false,
      "properties": {
        "speaker": { "type": "string", "description": "character_id，或 narration / inner / sfx" },
        "text":    { "type": "string", "minLength": 1 },
        "style":   { "type": "string", "enum": ["narration", "line", "inner", "sfx", "message"] }
      }
    },
    "conditional_dialogue": {
      "type": "array",
      "description": "條件式對白：依先前選擇／狀態，接在基本對白之後播放。",
      "items": {
        "type": "object",
        "required": ["condition", "dialogue"],
        "additionalProperties": false,
        "properties": {
          "condition": { "$ref": "#/definitions/expr" },
          "dialogue":  { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/dialogue_line" } }
        }
      }
    },
    "state_effect": {
      "type": "object",
      "required": ["var", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "var":   { "type": "string" },
        "op":    { "type": "string", "enum": ["add", "set", "max", "min"] },
        "value": { "type": "integer" }
      }
    },
    "expr": {
      "type": "object",
      "description": "條件運算式。恰好使用下列其中一種形式。",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "always": { "type": "boolean" },
        "all":    { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/expr" } },
        "any":    { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/expr" } },
        "not":    { "$ref": "#/definitions/expr" },
        "var":    { "type": "string" },
        "op":     { "type": "string", "enum": [">=", ">", "<=", "<", "==", "!="] },
        "value":  { "type": "integer" },
        "tag":    { "type": "string" },
        "count":  { "type": "integer" },
        "chose":  { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "ending": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "inner_voice_clue": {
      "type": "object",
      "description": "心聲線索：選擇後立即顯示的一段預先編寫文案，不由 AI 生成。",
      "required": ["clue_id", "title", "text"],
      "additionalProperties": false,
      "properties": {
        "clue_id": { "type": "string", "pattern": "^clue_[a-z0-9_]+$" },
        "title":   { "type": "string", "maxLength": 20 },
        "text":    { "type": "string", "minLength": 1 }
      }
    },
    "choice": {
      "type": "object",
      "required": ["choice_id", "text", "immediate", "consequence", "inner_voice_clue", "next_node_id"],
      "additionalProperties": false,
      "properties": {
        "choice_id":    { "type": "string", "pattern": "^c_[a-z0-9_]+$" },
        "text":         { "type": "string", "minLength": 1 },
        "hint":         { "type": "string", "description": "選項下方的一行補充，說明這個選擇大概是什麼姿態" },
        "immediate":    { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/dialogue_line" }, "description": "立即反應" },
        "consequence":  { "type": "string", "minLength": 1, "description": "實際後果（會在結局回顧列出）" },
        "inner_voice_clue": { "$ref": "#/definitions/inner_voice_clue" },
        "state_effects": { "type": "array", "items": { "$ref": "#/definitions/state_effect" } },
        "tags":          { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
        "condition":     { "$ref": "#/definitions/expr", "description": "選項出現條件；省略表示永遠出現" },
        "next_node_id":  { "type": "string" }
      }
    },
    "node": {
      "type": "object",
      "required": ["node_id", "node_type"],
      "additionalProperties": false,
      "properties": {
        "node_id":   { "type": "string", "pattern": "^n_[a-z0-9_]+$" },
        "node_type": { "type": "string", "enum": ["narration", "decision", "converge", "conditional", "ending"] },
        "title":     { "type": "string" },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "location": { "type": "string" },
            "time":     { "type": "string" },
            "mood":     { "type": "string" }
          }
        },
        "dialogue":             { "type": "array", "items": { "$ref": "#/definitions/dialogue_line" } },
        "conditional_dialogue": { "$ref": "#/definitions/conditional_dialogue" },
        "choices":              { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/definitions/choice" } },
        "conditions": {
          "type": "array", "minItems": 1,
          "description": "conditional 節點的分流規則，依序評估，第一個命中即跳轉。",
          "items": {
            "type": "object",
            "required": ["condition", "next_node_id"],
            "additionalProperties": false,
            "properties": {
              "condition":    { "$ref": "#/definitions/expr" },
              "next_node_id": { "type": "string" },
              "note":         { "type": "string" }
            }
          }
        },
        "default_next_node_id": { "type": "string", "description": "conditional 節點的保底出口，必填" },
        "state_effects":        { "type": "array", "items": { "$ref": "#/definitions/state_effect" } },
        "next_node_id":         { "type": "string" },
        "ending_id":            { "type": "string" },
        "converge_from":        { "type": "array", "items": { "type": "string" }, "description": "文件用：標註此匯流節點承接哪些分支" },
        "replay_note":          { "type": "string" }
      }
    },
    "ending": {
      "type": "object",
      "required": ["ending_id", "title", "dialogue", "recap"],
      "additionalProperties": false,
      "properties": {
        "ending_id": { "type": "string", "pattern": "^e_[0-9]{2}_[a-z0-9_]+$" },
        "title":     { "type": "string" },
        "dialogue":  { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/dialogue_line" } },
        "recap": {
          "type": "object",
          "required": ["summary"],
          "additionalProperties": false,
          "properties": {
            "summary":    { "type": "string", "description": "結局回顧的開場語，後面接玩家各節點的 consequence" },
            "closing":    { "type": "string" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "route": {
      "type": "object",
      "required": ["route_id", "name", "priority", "meaning", "narrative_explain", "rule", "practice_card_id", "island_growth_id"],
      "additionalProperties": false,
      "properties": {
        "route_id":  { "type": "string", "pattern": "^r_[0-9]{2}_[a-z0-9_]+$" },
        "name":      { "type": "string" },
        "priority":  { "type": "integer", "minimum": 1, "maximum": 3 },
        "meaning":   { "type": "string", "description": "敘事意涵（給設計團隊看的判定依據說明）" },
        "narrative_explain": { "type": "string", "description": "航線解析（給玩家看的文案）" },
        "rule":      { "$ref": "#/definitions/expr" },
        "practice_card_id":  { "type": "string", "pattern": "^pc_[0-9]{2}_[a-z0-9_]+$" },
        "island_growth_id":  { "type": "string", "pattern": "^ig_[0-9]{2}_[a-z0-9_]+$" }
      }
    }
  }
}
