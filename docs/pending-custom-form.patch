 <script>
+  // ====== 表單送出 ======
+  // 原生 form POST 送到隱藏 iframe，所以頁面不會跳走。
+  // 讀不到 iframe 的內容（跨網域），改以 load 事件判斷伺服器已回應。
+  (function(){
+    var form = document.getElementById('contact-form');
+    var sink = document.querySelector('.form-sink');
+    if (!form || !sink) return;
+
+    var statusEl = document.getElementById('form-status');
+    var btn = form.querySelector('button[type="submit"]');
+    var btnText = btn ? btn.textContent : '';
+    var waiting = false, timer = null;
+
+    function say(kind, html){
+      if (!statusEl) return;
+      statusEl.className = kind;
+      statusEl.style.display = 'block';
+      statusEl.innerHTML = html;
+    }
+    function restore(){
+      waiting = false;
+      if (timer) { clearTimeout(timer); timer = null; }
+      if (btn) { btn.disabled = false; btn.textContent = btnText; }
+    }
+
+    form.addEventListener('submit', function(){
+      // 讓瀏覽器自己做必填與 Email 格式檢查；沒過就不會走到這裡
+      var email = document.getElementById('f-email');
+      var mirror = document.getElementById('f-email-mirror');
+      if (email && mirror) mirror.value = email.value;
+
+      waiting = true;
+      if (btn) { btn.disabled = true; btn.textContent = '送出中…'; }
+      say('ok', '資料傳送中，請稍候…');
+
+      timer = setTimeout(function(){
+        if (!waiting) return;
+        say('err', '送出時發生問題，請稍後再試，或<a href="__FORM_VIEW_URL__">點此改用備用表單</a>。');
+        restore();
+      }, 15000);
+      // 不呼叫 preventDefault：交給瀏覽器原生送出
+    });
+
+    sink.addEventListener('load', function(){
+      if (!waiting) return;   // 第一次的空白載入不算
+      form.reset();
+      say('ok', '感謝您的填寫！確認信已寄到您的信箱，我們的顧問將於 1 個工作日內與您聯繫。');
+      restore();
+    });
+  })();
+
